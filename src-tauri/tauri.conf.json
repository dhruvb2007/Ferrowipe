{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ferrowipe",
  "version": "1.0.0",
  "identifier": "com.dhruvb2007.ferrowipe",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ferrowipe - Windows Disk Cleaner & Space Analyzer",
        "width": 1080,
        "height": 740,
        "minWidth": 940,
        "minHeight": 620,
        "center": true,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Dhruv Prajapati",
    "copyright": "Copyright (c) 2026 Dhruv Prajapati",
    "shortDescription": "Fast, safe Windows disk optimizer and space analyzer",
    "longDescription": "Ferrowipe is a fast, lightweight Windows disk optimizer, smart junk cleaner, live space analyzer, and app storage inspector built with Rust and Tauri 2.",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
