{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ferrowipe",
  "version": "0.1.0",
  "identifier": "com.dhruvb2007.ferrowipe",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ferrowipe - Windows Disk Cleaner & Space Analyzer",
        "width": 1080,
        "height": 740,
        "minWidth": 940,
        "minHeight": 620,
        "center": true,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
