  <Applications>
    <Application
      Id="Ferrowipe"
      Executable="ferrowipe.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Ferrowipe"
        Description="Fast, safe Windows disk optimizer, smart junk cleaner, live space analyzer, and app storage inspector."
